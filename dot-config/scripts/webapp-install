#!/usr/bin/env bash

# webapp-install
# Version: 1.0.0
# Description: Create web application shortcuts with desktop entries

set -euo pipefail

# Configuration
ICON_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="${HOME}/.local/share/applications"
BROWSER="brave"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Print colored messages
error() {
    echo -e "${RED}Error: $1${NC}" >&2
}

success() {
    echo -e "${GREEN}$1${NC}"
}

warn() {
    echo -e "${YELLOW}$1${NC}"
}

# Show usage information
show_usage() {
    cat << EOF
Usage: webapp-install [OPTIONS] [APP_NAME] [URL] [ICON_REF] [CUSTOM_EXEC] [MIME_TYPES]

Create web application shortcuts with desktop entries.

OPTIONS:
    -h, --help          Show this help message

ARGUMENTS (for direct mode):
    APP_NAME            Name of the web app (e.g., "YouTube Music")
    URL                 URL to open (e.g., "https://music.youtube.com")
    ICON_REF            Icon reference (URL or local file path)
    CUSTOM_EXEC         Custom exec command (optional)
    MIME_TYPES          MIME types to handle (optional)

EXAMPLES:
    # Interactive mode (uses gum if available)
    webapp-install

    # Direct mode
    webapp-install "YouTube Music" "https://music.youtube.com" "https://example.com/icon.png"

    # With custom exec
    webapp-install "My App" "https://app.com" "/path/to/icon.png" "chromium --app=%u --profile=work"

    # With MIME types
    webapp-install "My App" "https://app.com" "icon.png" "" "x-scheme-handler/myapp"

EOF
}

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Sanitize app name for use as icon filename
sanitize_icon_name() {
    local name="$1"
    # Convert to lowercase, replace spaces and special chars with dashes
    echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-\|-$//g'
}

# Download or copy icon
handle_icon() {
    local icon_ref="$1"
    local icon_name="$2"
    local icon_path="${ICON_DIR}/${icon_name}.png"

    mkdir -p "$ICON_DIR"

    if [[ "$icon_ref" =~ ^https?:// ]]; then
        # Download from URL
        echo "Downloading icon from $icon_ref..."
        if command_exists curl; then
            curl -sSL "$icon_ref" -o "$icon_path" || {
                error "Failed to download icon"
                return 1
            }
        else
            error "curl is required to download icons"
            return 1
        fi
    elif [[ -f "$icon_ref" ]]; then
        # Copy local file
        echo "Copying icon from $icon_ref..."
        cp "$icon_ref" "$icon_path" || {
            error "Failed to copy icon"
            return 1
        }
    else
        error "Icon reference is neither a valid URL nor an existing file: $icon_ref"
        return 1
    fi

    echo "$icon_name"
}

# Create desktop entry
create_desktop_entry() {
    local app_name="$1"
    local url="$2"
    local icon_name="$3"
    local custom_exec="$4"
    local mime_types="$5"

    local desktop_file="${DESKTOP_DIR}/$(sanitize_icon_name "$app_name").desktop"
    local icon_path="${ICON_DIR}/${icon_name}.png"
    mkdir -p "$DESKTOP_DIR"

    local exec_line
    if [[ -n "$custom_exec" ]]; then
        exec_line="$custom_exec"
    else
        exec_line="${BROWSER} --app=${url}"
    fi

    cat > "$desktop_file" << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=${app_name}
Exec=${exec_line}
Icon=${icon_path}
Terminal=false
Categories=Network;WebApp;
StartupWMClass=${app_name}
EOF

    if [[ -n "$mime_types" ]]; then
        echo "MimeType=${mime_types}" >> "$desktop_file"
    fi

    chmod +x "$desktop_file"
    echo "$desktop_file"
}

# Update icon cache
update_icon_cache() {
    if command_exists gtk-update-icon-cache; then
        echo "Updating icon cache..."
        gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" 2>/dev/null || true
    fi
}

# Interactive mode using gum
interactive_mode() {
    if ! command_exists gum; then
        error "gum is required for interactive mode. Install it or use direct mode."
        echo "Install with: paru -S gum"
        echo ""
        show_usage
        exit 1
    fi

    echo "=== Web App Installer (Interactive Mode) ==="
    echo ""

    local app_name
    app_name=$(gum input --placeholder "App Name (e.g., YouTube Music)")
    [[ -z "$app_name" ]] && { error "App name is required"; exit 1; }

    local url
    url=$(gum input --placeholder "URL (e.g., https://music.youtube.com)")
    [[ -z "$url" ]] && { error "URL is required"; exit 1; }

    local icon_ref
    icon_ref=$(gum input --placeholder "Icon URL or file path")
    [[ -z "$icon_ref" ]] && { error "Icon reference is required"; exit 1; }

    local custom_exec
    custom_exec=$(gum input --placeholder "Custom exec command (optional, press Enter to skip)")

    local mime_types
    mime_types=$(gum input --placeholder "MIME types (optional, press Enter to skip)")

    install_webapp "$app_name" "$url" "$icon_ref" "$custom_exec" "$mime_types"
}

# Main installation function
install_webapp() {
    local app_name="$1"
    local url="$2"
    local icon_ref="$3"
    local custom_exec="${4:-}"
    local mime_types="${5:-}"

    echo ""
    echo "Installing web app: $app_name"
    echo "URL: $url"
    echo ""

    # Handle icon
    local icon_name
    icon_name=$(sanitize_icon_name "$app_name")
    handle_icon "$icon_ref" "$icon_name" || exit 1

    # Create desktop entry
    local desktop_file
    desktop_file=$(create_desktop_entry "$app_name" "$url" "$icon_name" "$custom_exec" "$mime_types")

    # Update icon cache
    update_icon_cache

    echo ""
    success "✓ Web app installed successfully!"
    echo "Desktop file: $desktop_file"
    echo "Icon: ${ICON_DIR}/${icon_name}.png"
    echo ""
    echo "You can now find '$app_name' in your application launcher."
}

# Main script logic
main() {
    # Parse options
    case "${1:-}" in
        -h|--help)
            show_usage
            exit 0
            ;;
        "")
            # No arguments - interactive mode
            interactive_mode
            ;;
        *)
            # Direct mode - check for required arguments
            if [[ $# -lt 3 ]]; then
                error "Insufficient arguments for direct mode"
                echo ""
                show_usage
                exit 1
            fi

            local app_name="$1"
            local url="$2"
            local icon_ref="$3"
            local custom_exec="${4:-}"
            local mime_types="${5:-}"

            install_webapp "$app_name" "$url" "$icon_ref" "$custom_exec" "$mime_types"
            ;;
    esac
}

main "$@"

