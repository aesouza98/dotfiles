# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Auth tokens / credentials (NEVER commit) ───────────────────────────────────
dot-config/gh/hosts.yml
dot-config/github-copilot/
# pip.conf contains work-specific AWS CodeArtifact URL with embedded credentials.
# Regenerate with the codeartifact-login script when needed.
dot-config/pip/

# ── Work / macOS-specific apps with logs and databases ─────────────────────────
dot-config/AWSVPNClient/

# ── Auto-generated runtime state and caches ────────────────────────────────────
dot-config/atuin/history.db
dot-config/cagent/
dot-config/configstore/
dot-config/containers/
dot-config/uv/

# ── Editor runtime data (keep settings.json and themes, not runtime data) ──────
dot-config/zed/conversations/
dot-config/zed/prompts/

# ── Secrets (configure manually on each machine) ───────────────────────────────
dot-config/fish/conf.d/secrets.fish

# ── Backup / scratch files ──────────────────────────────────────────────────────
dot-config/zellij/config.kdl.bak
dot-config/zellij/config.kdl.bak.1
dot-config/ghostty/config.bkp
dot-config/fish/conf.d/fish_frozen_key_bindings.fish
dot-config/fish/conf.d/fish_frozen_theme.fish
dot-config/fish/conf.d/fish_frozen_theme.fish.bak

# ── ~/.local/bin: machine-specific symlinks and large binaries ──────────────────
dot-local/bin/aws-secrets
dot-local/bin/aws-secrets_beta
dot-local/bin/claude
dot-local/bin/terraform
dot-local/bin/uv
dot-local/bin/uvx

# ── ~/.local/pipx: Python virtual envs (reinstall with pipx reinstall-all) ─────
dot-local/pipx/

# ── ~/.local/share: runtime app data (not source-controlled) ───────────────────
dot-local/share/atuin/
dot-local/share/claude/
dot-local/share/containers/
dot-local/share/fish/
dot-local/share/man/
dot-local/share/nvim/
dot-local/share/uv/
dot-local/share/zinit/
dot-local/share/.DS_Store

# ── ~/.local/state: all runtime state ─────────────────────────────────────────
dot-local/state/
