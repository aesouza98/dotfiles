ZSH_THEME=""

# Set OhMyZsh home
export ZSH="$HOME/.oh-my-zsh"

# Init OhMyZsh
source $ZSH/oh-my-zsh.sh

# PyEnv & fzf completions
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# Set PATH
export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin"
# App-specific CLI paths (only if installed)
[[ -d "/Applications/Sublime Text.app" ]] && export PATH="$PATH:/Applications/Sublime Text.app/Contents/SharedSupport/bin"
[[ -d "/Applications/Visual Studio Code.app" ]] && export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Oh-My-ZSH Plugins
plugins=(git)

# ZSH Plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# Zinit plugins
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-completions
zinit light olets/zsh-abbr
# zinit light Aloxaf/fzf-tab

# Define Aliases
source ~/.config/shell/aliases
# source ~/.config/shell/abbreviations

# Zoxide
eval "$(zoxide init zsh)"

# Starship Prompt
eval "$(starship init zsh)"

# Mac Setup -- Terraform and postgres
complete -o nospace -C /opt/homebrew/bin/terraform terraform
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"

# Carapace -- Completions
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)
zstyle ':completion:*:git:*' group-order 'main commands' 'alias commands' 'external commands'
