ZSH_THEME=""

# Set OhMyZsh home
export ZSH="$HOME/.oh-my-zsh"

# Init OhMyZsh
source $ZSH/oh-my-zsh.sh

# fzf completions
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Set PATH
export PATH="$PATH:/Users/adriano.elias/.local/bin:/opt/homebrew/bin:/Applications/Sublime\ Text.app/Contents/SharedSupport/bin/:/Applications/Visual Studio Code.app/Contents/Resources/app/bin/"

# Oh-My-ZSH Plugins
plugins=(git)

# ZSH Plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "${ZINIT_HOME}/zinit.zsh"

# Zinit plugins
zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-completions
zinit light olets/zsh-abbr

# Define Aliases
source ~/.config/shell/aliases
# source ~/.config/shell/abbreviations

# Zoxide
eval "$(zoxide init zsh)"

# Starship Prompt
eval "$(starship init zsh)"

