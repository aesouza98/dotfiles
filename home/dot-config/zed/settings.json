{
  "helix_mode": true,
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "dock": "left",
  },
  "tab_size": 2,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-3.1-pro-preview",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "restore_on_startup": "launchpad",
  "redact_private_values": false,
  "base_keymap": "VSCode",
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Flexoki Light",
    "dark": "Flexoki Dark",
  },
  "terminal": {
    "shell": {
      "program": "/run/current-system/sw/bin/zsh",
    },
  },
}
