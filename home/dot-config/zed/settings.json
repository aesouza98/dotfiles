{
  "agent_servers": {
    "devin": {
      "default_config_options": {
        "mode": "bypass",
        "thought_level": "high",
        "model": "claude-opus-5-5-medium"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "sonnet"
      },
      "type": "registry"
    }
  },
  "helix_mode": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "base_keymap": "VSCode",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "agent": {
    "threads_sidebar": {
      "auto_open": false
    },
    "dock": "right",
    "profiles": {
      "code": {
        "default_model": {
          "provider": "google",
          "model": "gemini-3.1-pro-preview",
          "enable_thinking": true
        },
        "name": "Code",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_profile": "write",
    "default_model": {
      "provider": "google",
      "model": "gemini-3.1-pro-preview",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "icon_theme": "Catppuccin Mocha",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 13,
  "terminal": {
    "dock": "bottom",
    "starts_open": true,
    "font_weight": 300.0,
    "font_size": 13.0,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "shell": {
      "program": "/bin/zsh",
    },
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "vim_mode": false,
  "use_system_path_prompts": false,
  "close_panel_on_toggle": true,
  "relative_line_numbers": "enabled",
}
