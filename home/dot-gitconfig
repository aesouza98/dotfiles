[alias]
	st = status --short
	ch = checkout
	chb = checkout -b
	c = commit -m
	lg = log --color --graph --branches --all --decorate --oneline
	stat = diff --stat
	main = "!git checkout $(git symbolic-ref --short refs/remotes/origin/HEAD | sed \"s|^origin/||\")"
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	sw = "!git branch --format='%(refname:short)' | fzf | xargs -r git switch"

	# Usage: git fixup   (escolhe o commit alvo com fzf)
	fixup = "!git log -n 30 --oneline --no-merges origin/HEAD..HEAD | fzf | cut -d' ' -f1 | xargs -r git commit --fixup"

	# Usage: git gone   (deleta branches locais sem upstream)
	gone = "!git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2==\"[gone]\"{print $1}' | xargs -r git branch -D"

	# Usage: git squash <branch>
	squash = "!f(){ git reset --soft $(git merge-base \"$1\" HEAD) && git commit;};f"

	# Usage: git sign [branch]   (default: branch atual)
	# Assina TODOS os commits da branch que ainda nao estao na default branch e faz force-push.
	# Merge commits sao achatados: nesse caso o rebase e feito na default branch, nao na merge-base.
	# "Assinado" = commit tem header gpgsig (nao usa %G?, que exige gpg instalado e reporta
	# assinaturas PGP de terceiros, tipo merges web-flow do GitHub, como ausentes).
	sign = "!f() { \
			b=\"${1:-$(git branch --show-current)}\"; \
			[ -n \"$b\" ] || { echo \"git sign: HEAD desanexado; use: git sign <branch>\" >&2; return 1; }; \
			d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || d=origin/master; \
			case \"$b\" in master|main|\"${d#origin/}\") echo \"git sign: recusando force-push em $b\" >&2; return 1;; esac; \
			[ -z \"$(git status --porcelain)\" ] || { echo \"git sign: working tree sujo; commite ou stashe antes (reset --hard descartaria tudo)\" >&2; return 1; }; \
			git fetch --quiet origin \"$b\" \"${d#origin/}\" && git checkout --quiet \"$b\" || return 1; \
			n=$(git rev-list --count \"origin/$b..HEAD\") || return 1; \
			[ \"$n\" = 0 ] || { echo \"git sign: $n commit(s) local(is) fora de origin/$b; empurre-os antes (reset --hard os descartaria)\" >&2; return 1; }; \
			git reset --hard -q \"origin/$b\" || return 1; \
			base=$(git merge-base HEAD \"$d\") || return 1; \
			[ \"$base\" != \"$(git rev-parse HEAD)\" ] || { echo \"git sign: $b nao tem commits alem de $d\" >&2; return 1; }; \
			u=0; for c in $(git rev-list \"$d..HEAD\"); do git cat-file commit \"$c\" | awk 'NF==0{exit} /^gpgsig/{s=1} END{exit !s}' || u=$((u+1)); done; \
			[ \"$u\" != 0 ] || { echo \"git sign: todos os commits de $b ja estao assinados\"; return 0; }; \
			m=$(git rev-list --count --merges \"$d..HEAD\"); \
			onto=\"$base\"; \
			[ \"$m\" = 0 ] || { onto=\"$d\"; echo \"git sign: $m merge commit(s) serao achatados; rebase de $b em $d\"; }; \
			echo \"git sign: $u commit(s) sem assinatura; rebase de $b em $onto\"; \
			git rebase --force-rebase --gpg-sign \"$onto\" || { echo \"git sign: rebase parou (conflito?); resolva e rode 'git rebase --continue' ou 'git rebase --abort'. Nada foi enviado.\" >&2; return 1; }; \
			git push --force-with-lease origin \"$b\"; \
			}; f"

	# Usage: git resign [branch]   (default: branch atual)
	# Achata a branch em 1 commit assinado e faz force-push.
	resign = "!f() { \
			b=\"${1:-$(git branch --show-current)}\"; \
			d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || d=origin/master; \
			case \"$b\" in ''|master|main|\"${d#origin/}\") echo \"git resign: branch invalida: '$b'\" >&2; return 1;; esac; \
			[ -z \"$(git status --porcelain)\" ] || { echo \"git resign: working tree sujo\" >&2; return 1; }; \
			git fetch --quiet origin \"$b\" \"${d#origin/}\" && git checkout --quiet \"$b\" || return 1; \
			[ \"$(git rev-list --count \"origin/$b..HEAD\")\" = 0 ] || { echo \"git resign: commits locais fora de origin/$b; empurre antes\" >&2; return 1; }; \
			git reset --hard -q \"origin/$b\" && base=$(git merge-base HEAD \"$d\") || return 1; \
			msg=$(gh pr view \"$b\" --json title -q .title 2>/dev/null); [ -n \"$msg\" ] || msg=$(git log -1 --format=%s); \
			me=$(git config user.email); \
			co=$(git log --format='Co-authored-by: %an <%ae>%n%(trailers:key=Co-authored-by)' \"$base..HEAD\" | grep -v '^$' | grep -viF \"<$me>\" | sort -u); \
			git reset --soft \"$base\" && git diff --cached --stat && printf '%s\\n%s\\n' \"$msg\" \"$co\"; \
			printf 'Commit e force-push em %s? [y/N] ' \"$b\"; read r; \
			[ \"$r\" = y ] || { git reset --hard -q \"origin/$b\"; echo 'git resign: cancelado'; return 1; }; \
			git commit -S -q -m \"$msg\" ${co:+-m \"$co\"} || { git reset --hard -q \"origin/$b\"; return 1; }; \
			git push --force-with-lease origin \"$b\"; \
			}; f"

[user]
	email = github@nano.slmail.me
	name = Adriano Elias
	signingkey = /Users/adriano.elias/.ssh/signing.pub

[gpg]
	format = ssh

[commit]
	gpgsign = true
	verbose = true

[gpg "ssh"]
	allowedSignersFile = /Users/adriano.elias/.ssh/allowed_signers

[push]
	autoSetupRemote = true
	followTags = true
	useForceIfIncludes = true

[fetch]
	prune = true
	pruneTags = true
	fsckObjects = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies
	mnemonicPrefix = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname
	gpgSign = true

[column]
	ui = auto

[interactive]
	diffFilter = delta --color-only

[delta]
	line-numbers = true
	navigate = true

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[includeIf "gitdir/i:~/Git/"]
	path = ~/.gitconfig-ebanx

[includeIf "hasconfig:remote.*.url:git@github.com:ebanx/**"]
	path = ~/.gitconfig-ebanx

[core]
	editor = hx
	pager = delta
	fsmonitor = true
	untrackedCache = true
[maintenance]
	repo = /Users/adriano.elias/Git/pay
