#! /bin/bash
# Install or upgrade aws-secrets-cli from the EBANX CodeArtifact repository.
#
# The CodeArtifact index is exported for this process only, so no global pip/uv
# configuration is touched and an expired token can never break unrelated
# pip/uv/pipx usage.
#
# Usage:
#   aws-secrets-cli-install                             # latest version
#   aws-secrets-cli-install 2.6.1                       # pinned version
#   aws-secrets-cli-install 2.6.0b2437 --suffix _beta    # beta side by side
#   aws-secrets-cli-install --list                      # available versions
#
# Requirements, installed automatically with Homebrew when missing:
#   - AWS CLI v2
#   - pipx
#   - an AWS SSO profile for account 838648578997, named root-838648578997 by
#     default, override it with AWS_SECRETS_PROFILE=<profile>

set -euo pipefail

AWS_PROFILE_NAME="${AWS_SECRETS_PROFILE:-root-838648578997}"
AWS_REGION_NAME=us-east-1
DOMAIN=ebx-cloudops-domain
DOMAIN_OWNER=838648578997
REPOSITORY=ebx-cloudops-repo
PACKAGE=aws-secrets-cli

die() {
    echo "ERROR: $*" >&2
    exit 1
}

# Install a missing dependency with Homebrew, or explain how to get it
ensure_command() {
    local command_name="$1" brew_formula="$2"

    command -v "$command_name" > /dev/null 2>&1 && return 0

    echo "==> ${command_name} is not installed"
    command -v brew > /dev/null 2>&1 || die "install ${command_name} and run this again, on macOS: brew install ${brew_formula}"

    echo "==> Installing it with: brew install ${brew_formula}"
    brew install "$brew_formula"
    command -v "$command_name" > /dev/null 2>&1 || die "${command_name} is still not on the PATH after installing ${brew_formula}"
}

ensure_command aws awscli
ensure_command pipx pipx

case "$(aws --version 2>&1)" in
    aws-cli/2.*) ;;
    *) die "AWS CLI v2 is required, found: $(aws --version 2>&1). On macOS: brew install awscli" ;;
esac

# Matched in bash on purpose, `list-profiles | grep -q` breaks the pipe early and
# pipefail then reports a missing profile when it is actually there
profiles=$(aws configure list-profiles 2> /dev/null || true)

if [[ $'\n'"${profiles}"$'\n' != *$'\n'"${AWS_PROFILE_NAME}"$'\n'* ]]; then
    echo "ERROR: AWS profile '${AWS_PROFILE_NAME}' was not found" >&2
    candidates=$(echo "$profiles" | grep "$DOMAIN_OWNER" || true)
    if [ -n "$candidates" ]; then
        echo "Profiles for account ${DOMAIN_OWNER}:" >&2
        echo "$candidates" | sed 's/^/  /' >&2
        echo "Run it again as: AWS_SECRETS_PROFILE=<profile> $(basename "$0")" >&2
    else
        echo "Configure SSO access to account ${DOMAIN_OWNER} first, with: aws configure sso" >&2
    fi
    exit 1
fi

list_only=false
version=""

if [ "${1:-}" = "--list" ]; then
    list_only=true
    shift
elif [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    version="$1"
    shift
fi

# 1. Ensure there is an AWS session, log in only when it is really needed
if ! aws sts get-caller-identity --profile "$AWS_PROFILE_NAME" --region "$AWS_REGION_NAME" > /dev/null 2>&1; then
    echo "==> AWS session expired, running: aws sso login --profile ${AWS_PROFILE_NAME}"
    aws sso login --profile "$AWS_PROFILE_NAME"
fi

if [ "$list_only" = true ]; then
    aws codeartifact list-package-versions \
        --domain "$DOMAIN" \
        --domain-owner "$DOMAIN_OWNER" \
        --repository "$REPOSITORY" \
        --format pypi \
        --package "$PACKAGE" \
        --profile "$AWS_PROFILE_NAME" \
        --region "$AWS_REGION_NAME" \
        --output text \
        --query 'reverse(sort(versions[].version))'
    exit 0
fi

# 2. Short lived token, kept in this process environment only
TOKEN=$(aws codeartifact get-authorization-token \
    --domain "$DOMAIN" \
    --domain-owner "$DOMAIN_OWNER" \
    --duration-seconds 900 \
    --profile "$AWS_PROFILE_NAME" \
    --region "$AWS_REGION_NAME" \
    --output text \
    --query 'authorizationToken')

INDEX_URL="https://aws:${TOKEN}@${DOMAIN}-${DOMAIN_OWNER}.d.codeartifact.${AWS_REGION_NAME}.amazonaws.com/pypi/${REPOSITORY}/simple/"

# pip reads PIP_EXTRA_INDEX_URL, uv reads UV_EXTRA_INDEX_URL, pipx >= 1.16 uses
# uv as its backend whenever uv is on the PATH
export PIP_EXTRA_INDEX_URL="$INDEX_URL"
export UV_EXTRA_INDEX_URL="$INDEX_URL"

# 3. Install, or upgrade when the package is already there and no version is pinned
installed=$(pipx list --short 2> /dev/null || true)

if [ -z "$version" ] && [ $# -eq 0 ] && [[ $'\n'"${installed}" == *$'\n'"${PACKAGE} "* ]]; then
    echo "==> Upgrading ${PACKAGE}"
    pipx upgrade "$PACKAGE"
else
    spec="$PACKAGE"
    [ -n "$version" ] && spec="${PACKAGE}==${version}"
    echo "==> Installing ${spec}"
    pipx install "$spec" --force "$@"
fi

# 4. A fresh pipx installation is useless while its bin directory is not on the PATH
BIN_DIR=$(pipx environment --value PIPX_BIN_DIR 2> /dev/null || echo "${HOME}/.local/bin")
case ":${PATH}:" in
    *":${BIN_DIR}:"*) ;;
    *) echo "==> WARNING: ${BIN_DIR} is not on your PATH, run: pipx ensurepath" ;;
esac
